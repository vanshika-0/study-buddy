# Production backend configuration. Keep real secrets in the hosting provider,
# not in source control.
MONGO_URI=
FRONTEND_ORIGINS=https://study-buddy-one-swart.vercel.app
APP_TIMEZONE=Asia/Kolkata

# Email (Resend is preferred for production OTP delivery).
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Optional local SMTP fallback.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=465
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=false
MAIL_SSL_TLS=true
